APP_NAME=Ecommerce Platform (Sandbox)
APP_ENV=sandbox
DEBUG=true

DATABASE_URL=postgresql+psycopg2://ecom:ecom@localhost:5437/ecom_sandbox
REDIS_URL=redis://localhost:6378/0

JWT_SECRET=sandbox-secret-not-for-prod
